<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ground_segmentation</name>
  <version>0.1.0</version>
  <description>Traversable ground from image segmentation (GroundingDINO+SAM2) lifted to 3D with the LIO cloud: ground plane, ray fill of the lidar blind zone, odom log-odds grid.</description>
  <maintainer email="dev@qi.local">qi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>scene_memory</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
